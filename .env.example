# Bearer token clients must present. Required for the HTTP transport —
# the server refuses to start without it.
#
#   openssl rand -hex 32
MCP_API_KEY=

# Path to the YAML config holding your mailbox credentials.
CONFIG_PATH=config.yml

# http (remote, bearer-authenticated) or stdio (local only).
TRANSPORT=http

# Listen address. ADDR wins if both are set.
PORT=3000
# ADDR=:3000

# debug | info | warn | error
LOG_LEVEL=info

# Set to true only when a reverse proxy you control sits in front, so
# X-Forwarded-For can be trusted for rate limiting.
TRUST_PROXY=false

# Per-client requests per minute, by method.
RATE_LIMIT_GET_RPM=60
RATE_LIMIT_POST_RPM=240
